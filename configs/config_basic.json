    "dec_rho_hidden": 8,
    "dec_p": 4,
    "dec_q": 3,
    "encoder_depth": 1,
    "ode_depth": 1,
    "rho_net_depth": 2,
    "g_net_depth": 2,
    "dropout": 0.0,
    "euler_steps_per_interval": 4,
    "ode_solver": "euler",
    "use_rho_norm": false,
    "beta_init_scale": 0.01
  },
  "lr": 0.001,
  "wd": 1e-05,
  "epochs": 1000,
  "batch_size": 128,
  "print_every": 25,
  "patience_init": 300,
  "patience_reset": 300,
  "sched_patience": 50,
  "ckpt_dir": "checkpoints2/simulation_baseline_decP_4_bmi",
  "ckpt_template": "best_model_ode_{tag}.pt"
}
