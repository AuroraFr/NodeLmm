{
  "name": "basic",
  "data_kind": "rds_sim",
  "time_varying_features": [
    "BMI_t"
  ],
  "static_features": [
    "SEX_code",
    "AGEc",
    "DIPNIV2",
    "DIPNIV3"
  ],
  "target_col": "ISA15_sim",
  "id_col": "NUM_ID",
  "time_col": "time",
  "data_dir": "simu_datasets/S2a_sims",
  "split_seed": 42,
  "test_ratio": 0.2,
  "train_csv": "",
  "val_csv": "",
  "all_csv": "",
  "interp_method": "linear",
  "mask_type": "binary",
  "seeds": [
    42
  ],
  "include_mask": false,
  "use_dynamic_in_ode": true,
  "encode_baseline_cov": false,
  "use_neural_re": true,
  "g_hidden": 8,
  "fullD": false,
  "use_rho_net": true,
  "use_dynamic_skip": true,
  "static_skip_dims": [0,1,2,3],
